/*
 * Numpad 21 phim - K21C - Pro Micro nRF52840 (nice!nano v2 compatible)
 * Ma tran 7x7, KHONG diode (ghosting khi bam nhieu phim).
 * Cot (C0-C6) la output, hang (R0-R6) la input pull-down.
 * Co physical-layout de dung ZMK Studio (zmk.studio).
 * 6 day LED dieu khien bang behavior &led_mode (xem src/led_mode.c).
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        /* C0 .. C6 */
        col-gpios
            = <&gpio0 11 GPIO_ACTIVE_HIGH>   /* C0 P0.11 */
            , <&gpio1 4  GPIO_ACTIVE_HIGH>   /* C1 P1.04 */
            , <&gpio0 31 GPIO_ACTIVE_HIGH>   /* C2 P0.31 */
            , <&gpio0 29 GPIO_ACTIVE_HIGH>   /* C3 P0.29 */
            , <&gpio0 2  GPIO_ACTIVE_HIGH>   /* C4 P0.02 */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>   /* C5 P1.15 */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>   /* C6 P1.13 */
            ;

        /* R0 .. R6 */
        row-gpios
            = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R0 P0.06 */
            , <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R1 P0.08 */
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R2 P0.17 */
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R3 P0.20 */
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R4 P0.22 */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R5 P0.24 */
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R6 P1.00 */
            ;
    };

    /*
     * Thu tu phim theo bo cuc vat ly (tren xuong, trai sang phai):
     *   ESC  TAB  BSPC FN
     *   NUM  /    *    -
     *   7    8    9
     *   4    5    6    +
     *   1    2    3    ENTER
     *   0    .
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <7>;
        map = <
            RC(4,4) RC(6,4) RC(5,6) RC(4,5)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
            RC(2,0) RC(2,1) RC(2,2)
            RC(1,0) RC(1,1) RC(1,2) RC(2,3)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(4,1) RC(4,2)
        >;
    };

    /*
     * Physical layout cho ZMK Studio. Don vi: 1/100 phim.
     * Thu tu phai TRUNG KHOP voi map cua default_transform o tren.
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Numpad21";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w    h    x    y    rot  rx   ry
            = <&key_physical_attrs 100 100    0    0      0   0    0>  /* ESC   */
            , <&key_physical_attrs 100 100  100    0      0   0    0>  /* TAB   */
            , <&key_physical_attrs 100 100  200    0      0   0    0>  /* BSPC  */
            , <&key_physical_attrs 100 100  300    0      0   0    0>  /* FN    */

            , <&key_physical_attrs 100 100    0  100      0   0    0>  /* NUM   */
            , <&key_physical_attrs 100 100  100  100      0   0    0>  /* /     */
            , <&key_physical_attrs 100 100  200  100      0   0    0>  /* *     */
            , <&key_physical_attrs 100 100  300  100      0   0    0>  /* -     */

            , <&key_physical_attrs 100 100    0  200      0   0    0>  /* 7     */
            , <&key_physical_attrs 100 100  100  200      0   0    0>  /* 8     */
            , <&key_physical_attrs 100 100  200  200      0   0    0>  /* 9     */

            , <&key_physical_attrs 100 100    0  300      0   0    0>  /* 4     */
            , <&key_physical_attrs 100 100  100  300      0   0    0>  /* 5     */
            , <&key_physical_attrs 100 100  200  300      0   0    0>  /* 6     */
            , <&key_physical_attrs 100 100  300  200      0   0    0>  /* +     */

            , <&key_physical_attrs 100 100    0  400      0   0    0>  /* 1     */
            , <&key_physical_attrs 100 100  100  400      0   0    0>  /* 2     */
            , <&key_physical_attrs 100 100  200  400      0   0    0>  /* 3     */
            , <&key_physical_attrs 100 100  300  400      0   0    0>  /* ENTER */

            , <&key_physical_attrs 100 100  100  500      0   0    0>  /* 0     */
            , <&key_physical_attrs 100 100  300  500      0   0    0>  /* .     */
            ;
    };

    behaviors {
        /*
         * 6 day LED qua 6 transistor PNP (S8550), base active-low (LOW = sang).
         * Thu tu: LED0..LED5 = P0.09 P0.10 P1.01 P1.02 P1.07 P1.11
         * Dung: &led_mode 1..9
         */
        led_mode: led_mode {
            compatible = "zmk,behavior-led-mode";
            #binding-cells = <1>;
            leds-gpios
                = <&gpio0 9  GPIO_ACTIVE_LOW>
                , <&gpio0 10 GPIO_ACTIVE_LOW>
                , <&gpio1 1  GPIO_ACTIVE_LOW>
                , <&gpio1 2  GPIO_ACTIVE_LOW>
                , <&gpio1 7  GPIO_ACTIVE_LOW>
                , <&gpio1 11 GPIO_ACTIVE_LOW>
                ;
        };

        /* &layer_cycle : Numpad -> Media -> L3 -> L4 -> L5 -> Numpad ... (bo qua layer FN) */
        layer_cycle: layer_cycle {
            compatible = "zmk,behavior-layer-cycle";
            #binding-cells = <0>;
            cycle-layers = [00 01 02 03 04];
        };
    };
};

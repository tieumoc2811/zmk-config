#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";
            bindings = <
                &kp ESC    &kp TAB    &kp BSPC   &mo 1
                &kp KP_NUMLOCK &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS
                &kp KP_N7  &kp KP_N8  &kp KP_N9
                &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER
                &kp KP_N0  &kp KP_DOT
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
                &bootloader &bt BT_CLR &out OUT_TOG &trans
                &trans      &trans     &trans       &trans
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2
                &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_USB &trans
                &trans      &trans     &trans       &trans
                &trans      &trans
            >;
        };
    };
};

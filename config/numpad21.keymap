#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * 6 layer (0..5). Layer 2..5 de dung ZMK Studio tu do gan phim.
 *
 * Thu tu 21 phim trong moi layer (tren xuong, trai sang phai):
 *   ESC  TAB  BSPC FN
 *   NUM  /    *    -
 *   7    8    9
 *   4    5    6    +
 *   1    2    3    ENTER
 *   0    .
 *
 * FN layer (layer 1):
 *   Hang tren : bootloader | xoa BT | doi USB/BLE | -
 *   Hang 2    : Studio unlock | BT0 | BT1 | BT2
 *   Cac so    : 7..9 / 4..6 / 1..3 = che do LED 7..9 / 4..6 / 1..3
 *   +  = BT3,  ENTER = BT4,  0 = ep dung USB,  '.' = bat/tat layer 2
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";
            bindings = <
                &kp ESC    &kp TAB    &kp BSPC   &mo 1
                &kp KP_NUMLOCK &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS
                &kp KP_N7  &kp KP_N8  &kp KP_N9
                &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER
                &kp KP_N0  &kp KP_DOT
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
                &bootloader    &bt BT_CLR     &out OUT_TOG   &trans
                &studio_unlock &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2
                &led_mode 7    &led_mode 8    &led_mode 9
                &led_mode 4    &led_mode 5    &led_mode 6    &bt BT_SEL 3
                &led_mode 1    &led_mode 2    &led_mode 3    &bt BT_SEL 4
                &out OUT_USB   &tog 2
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &kp C_PREV  &kp C_PP      &kp C_NEXT   &trans
                &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP &kp C_CALC
                &kp HOME    &kp UP        &kp END
                &kp LEFT    &kp DOWN      &kp RIGHT    &kp PG_UP
                &kp INS     &kp DEL       &kp PG_DN    &kp RET
                &trans      &trans
            >;
        };

        layer_3 {
            display-name = "Layer 3";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans
            >;
        };

        layer_4 {
            display-name = "Layer 4";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans
            >;
        };

        layer_5 {
            display-name = "Layer 5";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans
            >;
        };
    };
};

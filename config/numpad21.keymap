#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * 6 layer: 0 Numpad, 1 Media, 2-4 trong (gan bang ZMK Studio), 5 FN.
 * FN o tren cung (index 5) nen luon de len cac layer khac: giu FN thi cac phim FN luon hoat dong.
 *
 * Thu tu 21 phim trong moi layer (tren xuong, trai sang phai):
 *   ESC  TAB  BSPC FN
 *   NUM  /    *    -
 *   7    8    9
 *   4    5    6    +
 *   1    2    3    ENTER
 *   0    .
 *
 * FN layer (layer 5, giu phim FN):
 *   Hang tren : bootloader | chuyen layer (Numpad>Media>L3>L4>L5) | doi USB/BLE | -
 *   Hang 2    : Studio unlock | BT0 | BT1 | BT2
 *   '.'       : chuyen che do LED ke tiep (1..9, vong lai)
 *   +  = BT3,  ENTER = BT4,  0 = ep dung USB,  1 = xoa ghep doi BT
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Numpad";
            bindings = <
                &kp ESC    &kp TAB    &kp BSPC   &mo 5
                &kp KP_NUMLOCK &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS
                &kp KP_N7  &kp KP_N8  &kp KP_N9
                &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER
                &kp KP_N0  &kp KP_DOT
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &kp C_PREV  &kp C_PP      &kp C_NEXT   &trans
                &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP &kp C_AL_CALC
                &kp HOME    &kp UP        &kp END
                &kp LEFT    &kp DOWN      &kp RIGHT    &kp PG_UP
                &kp INS     &kp DEL       &kp PG_DN    &kp RET
                &to 0       &trans
            >;
        };

        layer_3 {
            display-name = "Layer 3";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &to 0   &trans
            >;
        };

        layer_4 {
            display-name = "Layer 4";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &to 0   &trans
            >;
        };

        layer_5 {
            display-name = "Layer 5";
            bindings = <
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans
                &to 0   &trans
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
                &bootloader    &layer_cycle   &out OUT_TOG   &trans
                &studio_unlock &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2
                &none          &none          &none
                &none          &none          &none          &bt BT_SEL 3
                &bt BT_CLR     &none          &none          &bt BT_SEL 4
                &out OUT_USB   &led_mode 0
            >;
        };
    };
};
